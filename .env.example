APP_NAME=movieagent
GIN_MODE=debug
APP_HOST=0.0.0.0
APP_PORT=8080

# Model catalog (YAML). Defaults to internal/service/models/models.yaml
MODELS_CONFIG=internal/service/models/models.yaml
GEMINI_MODEL=gemini-3.5-flash
DRAW_MODEL=nano-banana-pro
WORKFLOW_VIDEO_MODEL=veo-3.1-generate-preview

# Providers (from linmu)
# Loaded into process env at startup; LocalSandbox also passthroughs GEMINI_API_KEY.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Clash Verge mixed-port (required in CN when TUN is off; Go does not use macOS system proxy)
GEMINI_HTTP_PROXY=http://127.0.0.1:7897
HTTPS_PROXY=http://127.0.0.1:7897
HTTP_PROXY=http://127.0.0.1:7897
MOARK_API_KEY=
MOARK_BASE_URL=https://ai.gitee.com
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io
OPENAI_API_KEY=
# DeepSeek chat (初始化方案). Official API or OpenAI-compatible gateway.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Local Whisper STT (no LLM). Reuse chapter07 venv if VOICE_PYTHON is empty.
# VOICE_PYTHON=/Users/amguolin/pi-agent-notebook/chapter/chapter07/.venv/bin/python
WHISPER_MODEL=tiny

# Local SD1.5 picture-book illustrator (skills/public/picturebook-illustrate)
# PICTUREBOOK_PYTHON=/path/to/skills/public/picturebook-illustrate/scripts/.venv/bin/python
# PICTUREBOOK_MODEL=stable-diffusion-v1-5/stable-diffusion-v1-5
# PICTUREBOOK_LORA=/path/to/skills/public/picturebook-illustrate/assets/models/lora/your-lora.safetensors
# PICTUREBOOK_LORA_SCALE=0.85
# PICTUREBOOK_LORA_TRIGGER=picturebook pencil watercolor
# PICTUREBOOK_DRY_RUN=1

# Aliyun OSS — chat agent runtime images (SSE image.url).
# When unset, falls back to local /media/generated/...
# OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# OSS_BUCKET=
# Optional CDN / custom domain (no trailing slash)
# OSS_PUBLIC_BASE_URL=https://cdn.example.com
# OSS_KEY_PREFIX=movieagent/chat/
